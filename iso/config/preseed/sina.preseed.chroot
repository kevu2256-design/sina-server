# ---------------------------------------------------------------------------
# Sina Server - debconf-Preseed fuer die chroot-Stage
#
# Verhindert interaktive Rueckfragen beim Paketieren (Tastatur, Zeitzone,
# Locales). Wird von live-build vor der Paketinstallation geladen.
# ---------------------------------------------------------------------------

# Tastaturlayout (Deutschland)
keyboard-configuration	keyboard-configuration/layoutcode	string	de
keyboard-configuration	keyboard-configuration/modelcode	string	pc105
keyboard-configuration	keyboard-configuration/variantcode	string	
keyboard-configuration	keyboard-configuration/xkb-keymap	select	de

# Zeitzone
tzdata	tzdata/Areas	select	Europe
tzdata	tzdata/Zones/Europe	select	Berlin

# Locales
locales	locales/locales_to_be_generated	multiselect	de_DE.UTF-8 UTF-8, en_US.UTF-8 UTF-8
locales	locales/default_environment_locale	select	de_DE.UTF-8

# Konsolen-Setup
console-setup	console-setup/charmap47	select	UTF-8
console-setup	console-setup/codeset47	select	Guess optimal character set
