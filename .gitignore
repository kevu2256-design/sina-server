/iso/cache/
/iso/chroot/
/iso/binary/
/iso/*.iso
/iso/*.iso.zsync
/iso/*.sha256
/iso/*.packages
/iso/*.contents
/iso/*.files
/iso/*.log
/iso/binary.sh
/iso/binary.modified_timestamps
/iso/chroot.installed_tmp_pkgs
/iso/chroot.package-lists

